model_name           Barebones
out_dir              /project/galaxies/tjuchau/projects/EW_vs_Age/slug_tests
sim_type             cluster
n_trials             100
time_step            1e6
start_time           1e6
end_time             1e7

IMF                  lib/imf/chabrier.imf
CMF                  lib/cmf/slug_default.cmf
CLF                  lib/clf/nodisrupt.clf

cluster_mass         50000
tracks               mist_2016_vvcrit_40
atmospheres          lib/atmospheres
yield_dir            lib/yields

metallicity          1
specsyn_mode         sb99

compute_nebular     0   # <-- CRITICAL

phot_mode            L_nu
phot_bands           JWST_F187N

out_cluster          1
out_cluster_phot     0
out_cluster_spec     1

output_mode          ascii

